# https://discord.com/developers/applications -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=

# Same application page -> General Information -> Public Key
DISCORD_PUBLIC_KEY=

# Enable Developer Mode in Discord (User Settings -> Advanced), then
# right-click your server icon -> Copy Server ID
DISCORD_GUILD_ID=

# Right-click the target channel -> Copy Channel ID
DISCORD_CHANNEL_ID=

# Right-click the role that should be allowed to run the worker -> Copy Role ID
DISCORD_ALLOWED_ROLE_ID=

# One-time seed brief, only used for the very first generation before there's any
# chat/reactions to synthesize from. Quote it - unquoted values containing a comma
# fail to parse.
LOGO_BRIEF="logo for a 17-person software team, minimalist, geometric"

# Optional, defaults shown
DATABASE_PATH=bot.db
DATA_DIR=data
PORT=8080
